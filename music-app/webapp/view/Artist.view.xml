<mvc:View
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    controllerName="at.clouddna.music.controller.Artist"
    displayBlock="true">
    <f:DynamicPage id="artistPage" headerExpanded="true" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle id="artistPageTitle">
                <f:heading>
                    <HBox alignItems="Center">
                        <core:Icon src="sap-icon://music" class="sapUiSmallMarginEnd musicLibIcon"/>
                        <VBox>
                            <Title text="Music Library" level="H3"/>
                            <Text text="{= ${music>/artists}.length + ' artists'}" class="artistCountSubtitle"/>
                        </VBox>
                    </HBox>
                </f:heading>
                <f:actions>
                    <Button icon="sap-icon://palette" type="Transparent" press="onOpenThemePicker" tooltip="Change Theme"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <VBox class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom">
                    <SearchField id="searchField" placeholder="Search artists..." liveChange="onSearch" width="100%" class="sapUiSmallMarginBottom"/>
                    <HBox wrap="Wrap" class="genreChipsBar">
                        <Button id="genreAll"        text="All"        press="onGenreFilter" class="genreChip genreChipActive" app:genre="all"/>
                        <Button id="genreRock"       text="Rock"       press="onGenreFilter" class="genreChip" app:genre="rock"/>
                        <Button id="genrePop"        text="Pop"        press="onGenreFilter" class="genreChip" app:genre="pop"/>
                        <Button id="genreHipHop"     text="Hip-Hop"    press="onGenreFilter" class="genreChip" app:genre="hip-hop"/>
                        <Button id="genreElectronic" text="Electronic" press="onGenreFilter" class="genreChip" app:genre="electronic"/>
                        <Button id="genreJazz"       text="Jazz"       press="onGenreFilter" class="genreChip" app:genre="jazz"/>
                        <Button id="genreFavorites"  icon="sap-icon://favorite" text="Favorites" press="onGenreFilter" class="genreChip genreChipFavorites" app:genre="favorites"/>
                        <Button id="genreRecent"     icon="sap-icon://history"  text="Recent"    press="onGenreFilter" class="genreChip"                  app:genre="recent"/>
                    </HBox>
                </VBox>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox>
                <OverflowToolbar class="artistSortBar">
                    <Title text="Artists" level="H5"/>
                    <ToolbarSpacer/>
                    <SegmentedButton id="sortToggle" selectionChange="onSortChange" selectedKey="listeners">
                        <items>
                            <SegmentedButtonItem key="listeners" text="Popular"  icon="sap-icon://sort-descending"/>
                            <SegmentedButtonItem key="name"      text="A – Z" icon="sap-icon://alphabetical-order"/>
                        </items>
                    </SegmentedButton>
                </OverflowToolbar>
                <List
                    id="artistList"
                    items="{music>/artists}"
                    mode="SingleSelectMaster"
                    selectionChange="onNavToDetail"
                    noDataText="No artists found"
                    showSeparators="None">
                    <CustomListItem class="artistListItem" type="Navigation">
                        <HBox alignItems="Center" width="100%" class="artistItemContent">
                            <Text text="{music>rank}" class="{= ${music>rank} == 1 ? 'artistRank artistRankGold' : (${music>rank} == 2 ? 'artistRank artistRankSilver' : (${music>rank} == 3 ? 'artistRank artistRankBronze' : 'artistRank')) }"/>
                            <Avatar
                                src="{music>icon}"
                                fallbackIcon="sap-icon://person-placeholder"
                                displaySize="S"
                                class="artistAvatar"/>
                            <VBox class="artistInfo">
                                <HBox alignItems="Center">
                                    <Text text="{music>name}" class="artistName" maxLines="1" wrapping="false"/>
                                    <core:Icon
                                        src="sap-icon://media-play"
                                        class="nowPlayingIcon"
                                        visible="{= ${player>/currentTrack/artistName} === ${music>name} &amp;&amp; ${player>/isPlaying} === true}"/>
                                </HBox>
                                <Text text="{path: 'music>listeners', formatter: '.formatListeners'}" class="artistListeners"/>
                            </VBox>
                            <ToggleButton
                                icon="sap-icon://favorite"
                                type="Transparent"
                                pressed="{music>favorite}"
                                press="onToggleFavorite"
                                class="favoriteToggleBtn"/>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
